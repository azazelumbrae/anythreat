# Any Threat — config (copy this to .env and fill in)
# Priority: CLI flags > environment > this .env file

# Any OpenAI-compatible endpoint:
#   OpenAI        -> https://api.openai.com/v1
#   OpenRouter    -> https://openrouter.ai/api/v1
#   Groq          -> https://api.groq.com/openai/v1
#   Ollama        -> http://localhost:11434/v1
#   llama.cpp     -> http://localhost:8080/v1
AT_BASE_URL=https://api.openai.com/v1
AT_API_KEY=
AT_MODEL=gpt-4o-mini
# AT_TEMPERATURE=0.4

# --- Arsenal (opcional) ---
# NopeCHA (captcha): https://nopecha.com -> API key
# NOPECHA_KEY=
# SearXNG (búsqueda web): override si corre en otro puerto
# AT_SEARXNG=http://127.0.0.1:8080
# camofox (browser stealth): override de URL
# AT_CAMOFOX_URL=http://127.0.0.1:9377
