{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "firefox-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mozilla/firefox-devtools-mcp@latest",
        "--firefoxPath",
        "/Applications/LibreWolf.app/Contents/MacOS/librewolf",
        "--autoProfile",
        "--startUrl",
        "about:blank"
      ],
      "enabled": true,
      "timeout": 120000,
      "environment": {
        "PATH": "/Users/alvarosouza/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    }
  }
}
